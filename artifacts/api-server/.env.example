# AI Investment Assistant — API environment variables
# Copy to .env for local development, or set these in Replit Secrets.
#
# AI analyst (Gemini preferred, Groq fallback). At least one is required for
# the AI report and free chat to work. No credit card needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free economic data from FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional: earnings/IPO calendar enrichments (https://financialmodelingprep.com)
FMP_API_KEY=

# Server
PORT=8080
# Where watchlist + performance CSV are stored (defaults to ./data)
# DATA_DIR=